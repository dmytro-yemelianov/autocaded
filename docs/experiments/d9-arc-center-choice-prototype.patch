+//! Typed actions for the bounded ARC center-choice experiment.
+#[derive(Clone, Copy, Debug)]
+pub(crate) enum CenterChoice {
+    Angle,
+    Chord,
+}
+include!(concat!(env!("OUT_DIR"), "/arc_choices.rs"));
+pub(crate) fn center_choice(input: &str) -> Option<CenterChoice> {
+    CENTER_CHOICES
+        .iter()
+        .find(|(token, _)| input.eq_ignore_ascii_case(token))
+        .map(|(_, action)| *action)
+}
