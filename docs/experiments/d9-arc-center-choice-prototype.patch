+//! Bounded build-time experiment: two ARC center choices, no runtime interpreter.
+use serde::Deserialize;
+use std::{collections::BTreeSet, env, fs, path::PathBuf};
+
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Catalog {
+    schema_version: u32,
+    choices: Vec<Choice>,
+}
+#[derive(Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Choice {
+    context: Context,
+    token: String,
+    action: Action,
+    source: String,
+}
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Eq, PartialOrd, Ord)]
+#[serde(rename_all = "snake_case")]
+enum Context {
+    ArcCenterChoice,
+}
+#[derive(Clone, Copy, Debug, Deserialize, PartialEq, Eq, PartialOrd, Ord)]
+#[serde(rename_all = "snake_case")]
+enum Action {
+    Angle,
+    Chord,
+}
+
+pub fn generate(input: &str) -> Result<String, String> {
+    if input.len() > 4096 {
+        return Err("choice resource exceeds 4096 bytes".into());
+    }
+    let catalog: Catalog = serde_json::from_str(input).map_err(|e| e.to_string())?;
+    if catalog.schema_version != 1 || catalog.choices.len() != 2 {
+        return Err("expected v1 two-choice ARC center catalog".into());
+    }
+    let mut tokens = BTreeSet::new();
+    let mut actions = BTreeSet::new();
+    let mut rows = String::new();
+    for choice in catalog.choices {
+        if choice.token.len() != 1 || !choice.token.bytes().all(|b| b.is_ascii_uppercase()) {
+            return Err("choice token must be one uppercase ASCII letter".into());
+        }
+        if !tokens.insert((choice.context, choice.token.clone())) {
+            return Err("duplicate context/token".into());
+        }
+        if !actions.insert(choice.action) {
+            return Err("duplicate action".into());
+        }
+        if choice.source.trim().is_empty() || choice.source.chars().any(char::is_control) {
+            return Err("missing or invalid provenance".into());
+        }
+        rows.push_str(&format!(
+            "({:?}, CenterChoice::{:?}),\n",
+            choice.token, choice.action
+        ));
+    }
+    // Exactly two unique members of this closed action enum guarantees coverage.
+    Ok(format!(
+        "const CENTER_CHOICES: &[(&str, CenterChoice)] = &[{rows}];\n"
+    ))
+}
+pub fn build() {
+    const PATH: &str = "resources/arc-center-choices.json";
+    println!("cargo:rerun-if-changed={PATH}");
+    println!("cargo:rerun-if-changed=build_support/arc_choices.rs");
+    let generated = generate(&fs::read_to_string(PATH).expect(PATH)).expect("invalid ARC choices");
+    let output = PathBuf::from(env::var_os("OUT_DIR").expect("OUT_DIR"));
+    fs::write(output.join("arc_choices.rs"), generated).expect("write ARC choices");
+}
