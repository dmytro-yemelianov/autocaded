@@ -0,0 +1,41 @@
+#[allow(dead_code)]
+#[path = "../build_support/arc_choices.rs"]
+mod choices;
+use serde_json::{json, Value};
+const ORIGINAL: &str = include_str!("../resources/arc-center-choices.json");
+#[test]
+fn schema_rejects_unknown_context_action_field_and_invalid_provenance() {
+    assert!(choices::generate(ORIGINAL).is_ok());
+    for (pointer, value) in [
+        ("/schema_version", json!(2)),
+        ("/choices/0/context", json!("arc_start")),
+        ("/choices/0/action", json!("execute_script")),
+        ("/choices/0/token", json!("a")),
+        ("/choices/0/token", json!("А")),
+        ("/choices/0/source", json!(" ")),
+        ("/choices/0/source", json!("bad\nsource")),
+        ("/choices/1/token", json!("A")),
+        ("/choices/1/action", json!("angle")),
+    ] {
+        let mut value_to_check: Value = serde_json::from_str(ORIGINAL).unwrap();
+        *value_to_check.pointer_mut(pointer).unwrap() = value;
+        assert!(
+            choices::generate(&value_to_check.to_string()).is_err(),
+            "{pointer}"
+        );
+    }
+    for field in ["context", "token", "action", "source"] {
+        let mut input: Value = serde_json::from_str(ORIGINAL).unwrap();
+        input["choices"][0].as_object_mut().unwrap().remove(field);
+        assert!(choices::generate(&input.to_string()).is_err());
+    }
+    let mut input: Value = serde_json::from_str(ORIGINAL).unwrap();
+    input["choices"][0]["extra"] = json!(true);
+    assert!(choices::generate(&input.to_string()).is_err());
+    assert!(choices::generate(&ORIGINAL.replace(
+        "\"schema_version\": 1",
+        "\"schema_version\": 1, \"schema_version\": 1"
+    ))
+    .is_err());
+    assert!(choices::generate(&" ".repeat(4097)).is_err());
+}
